{
  "permissions": {
    "deny": [
      "Read(**/*.tfstate)",
      "Read(**/*.tfstate.*)",
      "Read(**/*.auto.tfvars)",
      "Read(**/*.auto.tfvars.json)",
      "Read(**/*.secret.tfvars)",
      "Read(~/.ovh.conf)",
      "Read(~/.github-apps/**)",
      "Read(~/AppData/Roaming/sops/age/**)",
      "Read(~/.config/sops/age/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh api -X:*)",
      "Bash(gh api --method:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(terraform force-unlock:*)",
      "Bash(sops edit:*)",
      "Bash(sops encrypt:*)"
    ]
  }
}
